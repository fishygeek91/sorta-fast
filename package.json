{
  "name": "sorta-fast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "In-browser race of shortest-path algorithms: Dijkstra vs BMSSP vs DMSY",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench:trace": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/trace-write.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
